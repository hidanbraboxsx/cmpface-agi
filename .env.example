# ==============================================================================
# SUPABASE (Banco de Dados e Autenticação)
# ==============================================================================
# URL pública do projeto Supabase
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
SUPABASE_URL="https://seu-projeto.supabase.co"

# Chave pública / anon key
VITE_SUPABASE_PUBLISHABLE_KEY="sua-anon-key-aqui"
SUPABASE_PUBLISHABLE_KEY="sua-anon-key-aqui"

# Chave secreta de serviço (Service Role) - Usada no backend/server functions
SUPABASE_SERVICE_ROLE_KEY="sua-service-role-key-aqui"

# ==============================================================================
# CONSULTA DE CPF (Hub do Desenvolvedor / Receita Federal)
# ==============================================================================
# Token ou tokens separados por vírgula para consulta de CPF
HUB_DEVELOPER_TOKENS="seu_token_aqui"

# ==============================================================================
# TELEGRAM BOT (Notificações em Tempo Real e Gestão de Leads)
# ==============================================================================
# Token do bot fornecido pelo @BotFather
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"

# ID do chat ou usuário do administrador no Telegram
TELEGRAM_ADMIN_CHAT_ID="123456789"

# ==============================================================================
# OPCIONAIS (Migrações e Cron Jobs)
# ==============================================================================
# URL de conexão Postgres direta para drizzle migrations
# LOVABLE_DB_MIGRATION_URL="postgresql://postgres:senha@db.seu-projeto.supabase.co:5432/postgres"

# Segredo para requisições de cron autenticadas
# LOVABLE_CRON_SECRET="seu-segredo-de-cron"

